# JobBuddy frontend. Copy to .env.local for local development.
# On Vercel, add these under Project Settings > Environment Variables.

# Base URL of the JobBuddy API (no trailing slash).
# Local API: http://localhost:8080    Deployed API: https://jobbuddy-api.onrender.com
JOBBUDDY_API_URL=http://localhost:8080

# Only if the API has AUTH_SECRET set: the same value, so this app can call it.
# It stays on the server and is never sent to the browser.
# JOBBUDDY_API_TOKEN=
